---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

const all = await getCollection("celebrations", (e) => !e.id.startsWith("_"));
// private = unlisted, not gated: still reachable by direct slug URL, just
// left out of this archive. A real passcode gate is flagged as v2 (see README).
const listed = all
  .filter((e) => !e.data.private)
  .map((e) => e.data)
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
---
<Layout title="wish.arshnah.in" description="every celebration, one file each.">
  <div class="kicker">
    <span>arshdeep &middot; wish.arshnah.in</span>
    <a href="https://arshnah.in">arshnah.in</a>
  </div>

  <h1>wishes</h1>
  <p class="sub">one page per celebration.</p>

  <div class="panel term">
    <p><span class="you">arsh@wish</span>:~$ ls -la ./wishes</p>
    {listed.length === 0 && <p class="empty">nothing here yet.</p>}
    {listed.map((c) => (
      <a class="row" href={`/${c.slug}`}>
        <span class="row-date mono">{c.date}</span>
        <span class="row-title">{c.title}</span>
        <span class="row-type mono">{c.type}</span>
      </a>
    ))}
    <p class="gap"><span class="you">arsh@wish</span>:~$ <span class="cursor">&nbsp;</span></p>
  </div>
</Layout>

<style>
  h1{font-size:1.8rem; margin:0 0 4px;}
  .sub{color:var(--mut); font-size:.95rem; margin:0 0 26px;}
  .term{font-family:var(--font-mono); font-size:.88rem;}
  .term > p{margin:0;}
  .you{color:var(--accent);}
  .gap{margin-top:14px !important;}
  .empty{color:var(--faint); margin:10px 0 0 !important;}
  .row{display:grid; grid-template-columns:110px 1fr 90px; gap:12px; padding:9px 0; color:var(--ink); border-bottom:1px solid var(--line);}
  .row:hover{text-decoration:none; color:var(--accent);}
  .row-date{color:var(--faint);}
  .row-type{color:var(--faint); text-align:right;}
</style>
