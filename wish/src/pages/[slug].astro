---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Countdown from "../components/Countdown.astro";
import Message from "../components/sections/Message.astro";
import Timeline from "../components/sections/Timeline.astro";
import Gallery from "../components/sections/Gallery.astro";
import Wishes from "../components/sections/Wishes.astro";
import Stats from "../components/sections/Stats.astro";
import Guestbook from "../components/Guestbook.astro";

export async function getStaticPaths() {
  // underscore-prefixed files (_template.json) are templates to copy, not
  // real celebrations — never build a live page for one.
  const all = await getCollection("celebrations", (e) => !e.id.startsWith("_"));
  return all.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const c = entry.data;

// countdown only renders if a future countdown_to was actually given —
// a past/missing one means the celebration already happened, no ticking clock
const showCountdown = !!c.countdown_to && new Date(c.countdown_to).getTime() > Date.now();

const dateLabel = new Date(c.date + "T00:00:00").toLocaleDateString("en-IN", { day: "numeric", month: "long", year: "numeric" });
---
<Layout title={c.title} description={c.tagline || c.title} accent={c.theme?.accent}>
  <div class="kicker">
    <span>arshdeep &middot; wish.arshnah.in/{c.slug}</span>
    <a href="https://arshnah.in">arshnah.in</a>
  </div>

  <header class="hero">
    {c.hero_quote && <p class="hero-quote mono">&ldquo;{c.hero_quote}&rdquo;</p>}
    <h1>{c.title}</h1>
    {c.tagline && <p class="tagline">{c.tagline}</p>}
    <div class="hero-date mono">{dateLabel}</div>
    {showCountdown && <Countdown target={c.countdown_to as string} />}
  </header>

  {c.sections.map((s) => {
    switch (s.type) {
      case "message": return <Message heading={s.heading} body={s.body} />;
      case "timeline": return <Timeline heading={s.heading} items={s.items} />;
      case "gallery": return <Gallery heading={s.heading} images={s.images} />;
      case "wishes": return <Wishes heading={s.heading} items={s.items} />;
      case "stats": return <Stats heading={s.heading} items={s.items} />;
      default: return null;
    }
  })}

  {c.guestbook_enabled && <Guestbook slug={c.slug} />}

  <footer>
    <p><span class="you">arsh@wish</span>:~/{c.slug}$ <span class="cursor">&nbsp;</span></p>
    <p><a href="https://arshnah.in">&larr; arshnah.in</a> &middot; <a href="/">all wishes</a></p>
  </footer>
</Layout>

<style>
  .hero{margin-bottom:8px;}
  .hero-quote{color:var(--faint); font-size:.85rem; margin:0 0 14px; font-style:italic;}
  h1{font-size:2rem; font-weight:700; letter-spacing:-.01em; margin:0 0 8px; line-height:1.15;}
  .tagline{color:var(--mut); font-size:1.05rem; margin:0 0 14px;}
  .hero-date{font-size:.8rem; color:var(--faint);}
  .you{color:var(--accent);}
  .guestbook-note{color:var(--faint); font-size:.85rem;}
</style>
