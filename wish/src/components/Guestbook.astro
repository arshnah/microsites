---
interface Props { slug: string }
const { slug } = Astro.props;
---
<div class="guestbook" data-slug={slug}>
  <div class="sect">leave a wish</div>
  <div class="panel gb-form">
    <input class="mono" type="text" maxlength="40" placeholder="name" data-role="name" />
    <textarea class="mono" maxlength="280" rows="2" placeholder="write something..." data-role="message"></textarea>
    <div class="gb-row">
      <button class="mono" data-role="submit">sign it</button>
      <span class="gb-err mono" data-role="error"></span>
    </div>
  </div>
  <div class="gb-list" data-role="list"></div>
</div>

<style>
  .gb-form input, .gb-form textarea{width:100%; background:var(--panel-2); border:1px solid var(--line); border-radius:8px; color:var(--ink); padding:9px 11px; font-size:.9rem; margin-bottom:8px; resize:vertical;}
  .gb-form input:focus, .gb-form textarea:focus{outline:none; border-color:var(--accent);}
  .gb-row{display:flex; align-items:center; gap:12px;}
  .gb-form button{background:var(--accent); border:none; border-radius:8px; color:#1a1206; font-weight:700; font-size:.85rem; padding:8px 18px; cursor:pointer;}
  .gb-form button:disabled{opacity:.5; cursor:default;}
  .gb-err{color:var(--bad); font-size:.8rem;}
  .gb-list{margin-top:16px;}
  .gb-entry{padding:10px 0; border-bottom:1px solid var(--line);}
  .gb-entry:last-child{border-bottom:none;}
  .gb-entry .gb-name{font-weight:700;}
  .gb-entry .gb-when{color:var(--faint); font-size:.75rem; margin-left:8px;}
  .gb-empty{color:var(--faint); font-size:.85rem;}
</style>

<script>
  function esc(s: string) { return s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c] as string)); }
  function when(iso: string) {
    try { return new Date(iso).toLocaleDateString("en-IN", { day: "numeric", month: "short" }); } catch { return ""; }
  }

  async function boot(root: HTMLElement) {
    const slug = root.dataset.slug;
    const listEl = root.querySelector<HTMLElement>('[data-role="list"]');
    const nameEl = root.querySelector<HTMLInputElement>('[data-role="name"]');
    const msgEl = root.querySelector<HTMLTextAreaElement>('[data-role="message"]');
    const btnEl = root.querySelector<HTMLButtonElement>('[data-role="submit"]');
    const errEl = root.querySelector<HTMLElement>('[data-role="error"]');

    async function load() {
      if (!listEl) return;
      try {
        const r = await fetch(`/api/wish-guestbook?slug=${encodeURIComponent(slug || "")}`);
        const d = await r.json();
        const entries = d.entries || [];
        listEl.innerHTML = entries.length
          ? entries.map((e: any) => `<div class="gb-entry"><span class="gb-name">${esc(e.name)}</span><span class="gb-when mono">${when(e.created_at)}</span><div>${esc(e.message)}</div></div>`).join("")
          : '<p class="gb-empty">no one yet — be the first.</p>';
      } catch { if (listEl) listEl.innerHTML = '<p class="gb-empty">couldn\'t load, try again.</p>'; }
    }

    btnEl?.addEventListener("click", async () => {
      const name = nameEl?.value.trim() || "";
      const message = msgEl?.value.trim() || "";
      if (errEl) errEl.textContent = "";
      if (!name || !message) { if (errEl) errEl.textContent = "name and message both required"; return; }
      if (btnEl) btnEl.disabled = true;
      try {
        const r = await fetch(`/api/wish-guestbook?slug=${encodeURIComponent(slug || "")}`, {
          method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ name, message }),
        });
        const d = await r.json();
        if (d.ok) { if (nameEl) nameEl.value = ""; if (msgEl) msgEl.value = ""; load(); }
        else if (errEl) errEl.textContent = d.error || "something went wrong";
      } catch { if (errEl) errEl.textContent = "something went wrong"; }
      finally { if (btnEl) btnEl.disabled = false; }
    });

    load();
  }

  document.querySelectorAll<HTMLElement>(".guestbook[data-slug]").forEach(boot);
</script>
