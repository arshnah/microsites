---
interface Props { heading: string; items: { date: string; text: string }[] }
const { heading, items } = Astro.props;
---
<div class="sect">{heading}</div>
<div class="timeline">
  {items.map((it) => (
    <div class="tl-row">
      <div class="tl-date mono">{it.date}</div>
      <div class="tl-line"><span class="tl-dot"></span></div>
      <div class="tl-text">{it.text}</div>
    </div>
  ))}
</div>
<style>
  .timeline{position:relative;}
  .tl-row{display:grid; grid-template-columns:74px 20px 1fr; column-gap:14px;}
  .tl-date{font-size:.78rem; color:var(--faint); padding-top:2px; text-align:right;}
  .tl-line{position:relative; display:flex; justify-content:center;}
  .tl-line::before{content:""; position:absolute; top:6px; bottom:-14px; width:1px; background:var(--line);}
  .tl-row:last-child .tl-line::before{display:none;}
  .tl-dot{width:9px; height:9px; border-radius:50%; background:var(--accent); margin-top:4px; z-index:1;}
  .tl-text{padding-bottom:22px; font-size:.96rem;}
</style>
