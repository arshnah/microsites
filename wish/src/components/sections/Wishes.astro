---
import { mdToHtml } from "../../lib/md";
interface Props { heading: string; items: { from: string; text: string }[] }
const { heading, items } = Astro.props;
---
<div class="sect">{heading}</div>
<div class="wishes">
  {items.map((it) => (
    <div class="wish-row">
      <div class="wish-text" set:html={mdToHtml(it.text)} />
      <div class="wish-from mono">— {it.from}</div>
    </div>
  ))}
</div>
<style>
  .wish-row{padding:14px 0; border-bottom:1px solid var(--line);}
  .wish-row:last-child{border-bottom:none;}
  .wish-text{font-size:1rem;}
  .wish-from{font-size:.78rem; color:var(--accent); margin-top:6px;}
</style>
