---
interface Props { heading: string; images: string[] }
const { heading, images } = Astro.props;
if (!images.length) throw new Error("gallery section needs at least one image — drop the section instead of shipping an empty grid");
---
<div class="sect">{heading}</div>
<div class="gallery" data-count={images.length}>
  {images.map((src, i) => <img src={src} loading="lazy" alt="" class={i === 0 && images.length % 2 === 1 ? "wide" : ""} />)}
</div>
<style>
  /* an odd count lets the first photo run wide instead of leaving a hole in
     a perfectly even grid — asymmetry on purpose, not a leftover gap */
  .gallery{display:grid; grid-template-columns:1fr 1fr; gap:8px;}
  .gallery img{width:100%; aspect-ratio:1; object-fit:cover; border-radius:calc(var(--radius) - 6px); background:var(--panel); border:1px solid var(--line); display:block;}
  .gallery img.wide{grid-column:1 / -1; aspect-ratio:16/9;}
</style>
