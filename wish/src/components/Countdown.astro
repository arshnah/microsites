---
// The one signature move (grain rule 5): the flame glyph flickers — an
// irregular, organic CSS animation, not a clean sine wave — for as long as
// the wish is still pending. The instant the target time passes, JS swaps in
// .granted: the flicker stops and the flame holds a steady glow. This is the
// only thing on the page that moves without a hover triggering it.
interface Props {
  target: string; // ISO datetime, already known to be in the future by the caller
}
const { target } = Astro.props;
---
<div class="countdown" data-target={target}>
  <div class="flame" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none">
      <path class="flame-path" d="M12 2c3 4-3 6 0 10-4-1-6-4-6-7 0-1 .3-2 1-3-1 3 1 4 2 3-1-2 1-2 3-3z" fill="currentColor"/>
      <path class="flame-path flame-inner" d="M12 10c1.5 1.5 2.5 3 2.5 5A4.5 4.5 0 1 1 9 15c0-1 .5-2 1.5-3 .3 1.2 1 1.7 1.5 1 .3-1-.5-1.7 0-3z" fill="currentColor"/>
    </svg>
  </div>
  <div class="digits mono" data-role="digits">
    <span data-u="d">&hellip;</span><span class="lbl">d</span>
    <span data-u="h">&hellip;</span><span class="lbl">h</span>
    <span data-u="m">&hellip;</span><span class="lbl">m</span>
    <span data-u="s">&hellip;</span><span class="lbl">s</span>
  </div>
  <div class="granted-msg mono" data-role="granted" hidden>the wish is granted. today&rsquo;s the day.</div>
</div>

<style>
  .countdown{display:flex; align-items:center; gap:16px; margin:14px 0 4px;}
  .flame{color:var(--accent); flex-shrink:0; filter:drop-shadow(0 0 6px color-mix(in srgb, var(--accent) 55%, transparent));}
  .flame-inner{opacity:.85;}

  /* irregular flicker: uneven timing + slight scale so it reads as a real
     flame, not a css demo pulsing on a metronome */
  .countdown:not(.granted) .flame{ animation:flicker 2.6s ease-in-out infinite; }
  @keyframes flicker{
    0%{opacity:1; transform:scale(1) rotate(0deg);}
    8%{opacity:.82; transform:scale(.96) rotate(-1deg);}
    19%{opacity:1; transform:scale(1.04) rotate(1deg);}
    33%{opacity:.9; transform:scale(.99) rotate(0deg);}
    47%{opacity:1; transform:scale(1.02) rotate(-1deg);}
    61%{opacity:.86; transform:scale(.97) rotate(1deg);}
    74%{opacity:1; transform:scale(1) rotate(0deg);}
    88%{opacity:.93; transform:scale(1.01) rotate(1deg);}
    100%{opacity:1; transform:scale(1) rotate(0deg);}
  }
  /* granted: flicker stops, flame holds a steady, slightly brighter glow */
  .countdown.granted .flame{filter:drop-shadow(0 0 10px color-mix(in srgb, var(--accent) 75%, transparent));}

  .digits{display:flex; align-items:baseline; gap:3px; font-size:1.05rem; color:var(--ink);}
  .digits span[data-u]{font-weight:700; min-width:1.6em; text-align:right;}
  .digits .lbl{color:var(--faint); font-size:.75rem; margin-right:8px; font-weight:400;}
  .granted-msg{color:var(--accent); font-size:.95rem;}

  @media (prefers-reduced-motion: reduce){ .countdown:not(.granted) .flame{animation:none;} }
</style>

<script>
  function tick(root: HTMLElement) {
    const target = new Date(root.dataset.target || "").getTime();
    const digitsEl = root.querySelector<HTMLElement>('[data-role="digits"]');
    const grantedEl = root.querySelector<HTMLElement>('[data-role="granted"]');
    const now = Date.now();
    const diff = target - now;

    if (diff <= 0) {
      root.classList.add("granted");
      if (digitsEl) digitsEl.hidden = true;
      if (grantedEl) grantedEl.hidden = false;
      return; // stop ticking, nothing left to count
    }

    const s = Math.floor(diff / 1000);
    const days = Math.floor(s / 86400);
    const hours = Math.floor((s % 86400) / 3600);
    const mins = Math.floor((s % 3600) / 60);
    const secs = s % 60;
    const set = (u: string, v: number) => {
      const el = root.querySelector(`[data-u="${u}"]`);
      if (el) el.textContent = String(v);
    };
    set("d", days); set("h", hours); set("m", mins); set("s", secs);
    setTimeout(() => tick(root), 1000);
  }

  document.querySelectorAll<HTMLElement>(".countdown[data-target]").forEach(tick);
</script>
